[Unit]
Description=Polymarket Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/polymarket_bot
EnvironmentFile=/home/ubuntu/polymarket_bot/.env
ExecStart=/home/ubuntu/polymarket_bot/venv/bin/python main.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/ubuntu/polymarket_bot/polymarket_bot.log
StandardError=append:/home/ubuntu/polymarket_bot/polymarket_bot.log

[Install]
WantedBy=multi-user.target
